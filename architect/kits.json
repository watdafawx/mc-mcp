{
  "version": 1,
  "doc": "Style kits for the architect (see docs/SCENE_GRAPH_DESIGN.md and palettes.py). Every role is an ordered fallback chain [preferred, ..., vanilla]: the resolver picks the first block that exists in the pack, else the last entry, which is always a vanilla minecraft: block. Element 0 of every chain is exactly the block massing.KITS uses today (v7/v10 overrides folded in). meta holds the per-kit layout tables from massing/interiors/campus (v15 roof_cycle, v16 roof_mats). Blockstate suffixes ([persistent=true]) are kept; only the id before '[' is checked against the registry.",
  "roles": {
    "base": "plinth, ground course, platform field",
    "wall": "main wall tone",
    "wall2": "second wall tone, interior floors, window spandrels",
    "trim": "ledges, frames, mullions, parapet cap",
    "pillar": "corner piers and pilasters (optional, default trim)",
    "accent": "one bold stripe (accent floor lintel)",
    "band": "lintel band on glow floors (optional, default glow)",
    "glass": "windows",
    "glow": "light bands, lantern cores",
    "rail": "parapet rail, lamp posts",
    "roof": "roof deck and roof surface",
    "detail": "roof units, vents",
    "antenna": "masts, finial shafts",
    "tip": "mast and finial tips",
    "dome_rib": "dome frame (optional, default trim)",
    "ridge": "roof ridge; its presence switches on gothic gable ends (optional)"
  },
  "required": ["base", "wall", "wall2", "trim", "accent", "glass", "glow", "rail", "roof", "detail", "antenna", "tip"],
